{
    "id": "playground-instruction",
    "comment": "Playground demonstration instruction",
    "version": "1.0.0",
    "operations": [
        {
            "id": "BuyDog",
            "comment": "Purchase a dog by breed with a budget limit. Demonstrates object composition, enum choice, and compound traits.",
            "input": [
                {
                    "id": "breed",
                    "comment": "Exact breed name, e.g. \"labrador\"",
                    "required": true,
                    "kind": "string"
                },
                {
                    "id": "budget",
                    "comment": "Maximum price in cents",
                    "required": true,
                    "kind": "integer"
                },
                {
                    "id": "express",
                    "comment": "Next-day delivery",
                    "kind": "boolean"
                },
                {
                    "id": "deliveryAddress",
                    "comment": "Where to deliver the dog",
                    "kind": "object",
                    "of": [
                        {
                            "id": "street",
                            "comment": "Street name and number",
                            "kind": "string"
                        },
                        {
                            "id": "city",
                            "comment": "City name",
                            "kind": "string"
                        },
                        {
                            "id": "zip",
                            "comment": "Postal code, not an archive",
                            "kind": "string"
                        },
                        {
                            "id": "country",
                            "comment": "ISO 3166-1 alpha-2",
                            "kind": "string",
                            "value": "US"
                        }
                    ]
                },
                {
                    "id": "preferredSize",
                    "comment": "Desired dog size category",
                    "kind": "enum",
                    "of": [
                        {
                            "id": "small",
                            "comment": "Up to 10 kg"
                        },
                        {
                            "id": "medium",
                            "comment": "10–25 kg"
                        },
                        {
                            "id": "large",
                            "comment": "Over 25 kg"
                        }
                    ]
                }
            ],
            "output": [
                {
                    "id": "orderId",
                    "comment": "UUID of the created order",
                    "kind": "string"
                },
                {
                    "id": "dog",
                    "comment": "The matched dog",
                    "kind": "object",
                    "of": [
                        {
                            "id": "id",
                            "comment": "UUID of the dog",
                            "kind": "string"
                        },
                        {
                            "id": "name",
                            "comment": "The name the shelter gave it",
                            "kind": "string"
                        },
                        {
                            "id": "breed",
                            "comment": "Breed name",
                            "kind": "string"
                        },
                        {
                            "id": "birthDate",
                            "comment": "Date of birth",
                            "kind": "datetime"
                        },
                        {
                            "id": "weightKg",
                            "comment": "Weight at last checkup",
                            "kind": "float"
                        },
                        {
                            "id": "vaccinated",
                            "comment": "Whether the dog is vaccinated",
                            "kind": "boolean"
                        }
                    ]
                },
                {
                    "id": "totalPrice",
                    "comment": "Final price including delivery, in cents",
                    "kind": "float"
                }
            ],
            "error": [
                {
                    "id": "BreedNotFound",
                    "comment": "No such breed in our catalog"
                },
                {
                    "id": "BudgetExceeded",
                    "comment": "All matching dogs cost more than budget"
                },
                {
                    "id": "OutOfStock",
                    "comment": "Breed exists but no dogs available right now"
                },
                {
                    "id": "DeliveryUnavailable",
                    "comment": "We do not deliver to this address"
                }
            ],
            "trait": [
                {
                    "id": "http/method",
                    "comment": "HTTP method for this operation",
                    "value": "POST"
                },
                {
                    "id": "http/path",
                    "comment": "URL path for this operation",
                    "value": "/dogs/buy"
                },
                {
                    "id": "auth/type",
                    "comment": "Authentication scheme",
                    "value": "bearer"
                },
                {
                    "id": "otel/span",
                    "comment": "OpenTelemetry span name",
                    "value": "BuyDog"
                },
                {
                    "id": "resilience/retry",
                    "comment": "Retry policy for transient failures",
                    "kind": "object",
                    "of": [
                        {
                            "id": "maxAttempts",
                            "comment": "Maximum number of retry attempts",
                            "kind": "integer",
                            "value": 3
                        },
                        {
                            "id": "backoff",
                            "comment": "Delay growth strategy between retries",
                            "kind": "enum",
                            "of": [
                                {
                                    "id": "linear",
                                    "comment": "Fixed delay between attempts"
                                },
                                {
                                    "id": "exponential",
                                    "comment": "Doubling delay between attempts"
                                }
                            ]
                        },
                        {
                            "id": "delayMs",
                            "comment": "Initial delay in milliseconds",
                            "kind": "integer",
                            "value": 500
                        }
                    ]
                },
                {
                    "id": "cli/command",
                    "comment": "CLI command name for this operation",
                    "value": "buy-dog"
                }
            ]
        },
        {
            "id": "ListBreeds",
            "comment": "Get all available dog breeds with optional size filter. Demonstrates array output and enum input.",
            "input": [
                {
                    "id": "size",
                    "comment": "Filter by dog size, or \"any\" for all",
                    "kind": "enum",
                    "of": [
                        {
                            "id": "small",
                            "comment": "Up to 10 kg"
                        },
                        {
                            "id": "medium",
                            "comment": "10–25 kg"
                        },
                        {
                            "id": "large",
                            "comment": "Over 25 kg"
                        },
                        {
                            "id": "any",
                            "comment": "No size filter — return all breeds"
                        }
                    ]
                }
            ],
            "output": [
                {
                    "id": "breeds",
                    "comment": "List of available breeds",
                    "kind": "array",
                    "of": [
                        {
                            "id": "breed",
                            "comment": "A single breed entry",
                            "kind": "object",
                            "of": [
                                {
                                    "id": "name",
                                    "comment": "Breed name",
                                    "kind": "string"
                                },
                                {
                                    "id": "size",
                                    "comment": "Size category",
                                    "kind": "string"
                                },
                                {
                                    "id": "avgPriceUsd",
                                    "comment": "Average market price in USD",
                                    "kind": "float"
                                },
                                {
                                    "id": "available",
                                    "comment": "At least one dog in stock",
                                    "kind": "boolean"
                                }
                            ]
                        }
                    ]
                }
            ],
            "error": [],
            "trait": [
                {
                    "id": "http/method",
                    "comment": "HTTP method for this operation",
                    "value": "GET"
                },
                {
                    "id": "http/path",
                    "comment": "URL path for this operation",
                    "value": "/breeds"
                },
                {
                    "id": "cli/command",
                    "comment": "CLI command name for this operation",
                    "value": "list-breeds"
                }
            ]
        },
        {
            "id": "GetOrder",
            "comment": "Retrieve order details by ID. Demonstrates nested objects and datetime.",
            "input": [
                {
                    "id": "orderId",
                    "comment": "UUID of the order",
                    "required": true,
                    "kind": "string"
                }
            ],
            "output": [
                {
                    "id": "order",
                    "comment": "The order object",
                    "kind": "object",
                    "of": [
                        {
                            "id": "id",
                            "comment": "UUID of the order",
                            "kind": "string"
                        },
                        {
                            "id": "status",
                            "comment": "Current lifecycle stage",
                            "kind": "enum",
                            "of": [
                                {
                                    "id": "pending",
                                    "comment": "Order placed, not yet confirmed"
                                },
                                {
                                    "id": "confirmed",
                                    "comment": "Order confirmed by the shop"
                                },
                                {
                                    "id": "shipped",
                                    "comment": "Dog is on the way"
                                },
                                {
                                    "id": "delivered",
                                    "comment": "Dog delivered to the owner"
                                },
                                {
                                    "id": "cancelled",
                                    "comment": "Order was cancelled"
                                }
                            ]
                        },
                        {
                            "id": "createdAt",
                            "comment": "When the order was placed",
                            "kind": "datetime"
                        },
                        {
                            "id": "dog",
                            "comment": "Snapshot of the dog at purchase time",
                            "kind": "object",
                            "of": [
                                {
                                    "id": "id",
                                    "comment": "UUID of the dog",
                                    "kind": "string"
                                },
                                {
                                    "id": "name",
                                    "comment": "Name of the dog",
                                    "kind": "string"
                                },
                                {
                                    "id": "breed",
                                    "comment": "Breed name",
                                    "kind": "string"
                                }
                            ]
                        },
                        {
                            "id": "totalPrice",
                            "comment": "Total price in cents",
                            "kind": "float"
                        },
                        {
                            "id": "express",
                            "comment": "Whether express delivery was chosen",
                            "kind": "boolean"
                        }
                    ]
                }
            ],
            "error": [
                {
                    "id": "OrderNotFound",
                    "comment": "No order with this ID exists"
                },
                {
                    "id": "Unauthorized",
                    "comment": "You do not have access to this order"
                }
            ],
            "trait": [
                {
                    "id": "http/method",
                    "comment": "HTTP method for this operation",
                    "value": "GET"
                },
                {
                    "id": "http/path",
                    "comment": "URL path for this operation",
                    "value": "/orders/{orderId}"
                },
                {
                    "id": "auth/type",
                    "comment": "Authentication scheme",
                    "value": "bearer"
                },
                {
                    "id": "otel/span",
                    "comment": "OpenTelemetry span name",
                    "value": "GetOrder"
                }
            ]
        },
        {
            "id": "UploadVaccineCard",
            "comment": "Upload a vaccine card scan for a dog. Demonstrates binary input.",
            "input": [
                {
                    "id": "dogId",
                    "comment": "UUID of the dog",
                    "required": true,
                    "kind": "string"
                },
                {
                    "id": "scan",
                    "comment": "JPEG or PNG scan of the vaccine card",
                    "required": true,
                    "kind": "binary"
                },
                {
                    "id": "issueDate",
                    "comment": "When the card was issued by the vet",
                    "kind": "datetime"
                }
            ],
            "output": [
                {
                    "id": "cardId",
                    "comment": "UUID of the uploaded card",
                    "kind": "string"
                },
                {
                    "id": "verified",
                    "comment": "Whether the card passed automated verification",
                    "kind": "boolean"
                }
            ],
            "error": [
                {
                    "id": "DogNotFound",
                    "comment": "No dog with this ID exists"
                },
                {
                    "id": "InvalidFile",
                    "comment": "Not a readable image"
                },
                {
                    "id": "FileTooLarge",
                    "comment": "Exceeds 10 MB limit"
                }
            ],
            "trait": [
                {
                    "id": "http/method",
                    "comment": "HTTP method for this operation",
                    "value": "POST"
                },
                {
                    "id": "http/path",
                    "comment": "URL path for this operation",
                    "value": "/dogs/{dogId}/vaccine-card"
                },
                {
                    "id": "auth/type",
                    "comment": "Authentication scheme",
                    "value": "bearer"
                }
            ]
        },
        {
            "id": "CancelOrder",
            "comment": "Cancel a pending order. Demonstrates operation with minimal output and multiple error paths.",
            "input": [
                {
                    "id": "orderId",
                    "comment": "UUID of the order to cancel",
                    "required": true,
                    "kind": "string"
                },
                {
                    "id": "reason",
                    "comment": "Reason for cancellation",
                    "kind": "string"
                }
            ],
            "output": [
                {
                    "id": "cancelled",
                    "comment": "Whether the order was successfully cancelled",
                    "kind": "boolean"
                }
            ],
            "error": [
                {
                    "id": "OrderNotFound",
                    "comment": "No order with this ID exists"
                },
                {
                    "id": "OrderAlreadyShipped",
                    "comment": "Cannot cancel — the dog is already on the way"
                },
                {
                    "id": "OrderAlreadyCancelled",
                    "comment": "This order has already been cancelled"
                },
                {
                    "id": "Unauthorized",
                    "comment": "You do not have access to this order"
                }
            ],
            "trait": [
                {
                    "id": "http/method",
                    "comment": "HTTP method for this operation",
                    "value": "POST"
                },
                {
                    "id": "http/path",
                    "comment": "URL path for this operation",
                    "value": "/orders/{orderId}/cancel"
                },
                {
                    "id": "auth/type",
                    "comment": "Authentication scheme",
                    "value": "bearer"
                },
                {
                    "id": "cli/command",
                    "comment": "CLI command name for this operation",
                    "value": "cancel-order"
                },
                {
                    "id": "resilience/timeout",
                    "comment": "Timeout policy for this operation",
                    "kind": "object",
                    "of": [
                        {
                            "id": "ms",
                            "comment": "Timeout in milliseconds",
                            "kind": "integer",
                            "value": 5000
                        }
                    ]
                }
            ]
        },
        {
            "id": "SearchDogs",
            "comment": "Full-text search across available dogs. Demonstrates array of objects with pagination.",
            "input": [
                {
                    "id": "query",
                    "comment": "Free-text search query",
                    "required": true,
                    "kind": "string"
                },
                {
                    "id": "limit",
                    "comment": "Maximum number of results to return",
                    "kind": "integer",
                    "value": 20
                },
                {
                    "id": "offset",
                    "comment": "Number of results to skip for pagination",
                    "kind": "integer",
                    "value": 0
                },
                {
                    "id": "filters",
                    "comment": "Optional filters to narrow the search",
                    "kind": "object",
                    "of": [
                        {
                            "id": "minPrice",
                            "comment": "Minimum price in cents",
                            "kind": "float"
                        },
                        {
                            "id": "maxPrice",
                            "comment": "Maximum price in cents",
                            "kind": "float"
                        },
                        {
                            "id": "vaccinated",
                            "comment": "Only show vaccinated dogs",
                            "kind": "boolean"
                        },
                        {
                            "id": "sizes",
                            "comment": "Filter by size categories",
                            "kind": "array",
                            "of": [
                                {
                                    "id": "size",
                                    "comment": "Size category: small, medium, or large",
                                    "kind": "string"
                                }
                            ]
                        }
                    ]
                }
            ],
            "output": [
                {
                    "id": "total",
                    "comment": "Total number of matching dogs",
                    "kind": "integer"
                },
                {
                    "id": "dogs",
                    "comment": "List of matching dogs",
                    "kind": "array",
                    "of": [
                        {
                            "id": "dog",
                            "comment": "A single dog entry",
                            "kind": "object",
                            "of": [
                                {
                                    "id": "id",
                                    "comment": "UUID of the dog",
                                    "kind": "string"
                                },
                                {
                                    "id": "name",
                                    "comment": "Name of the dog",
                                    "kind": "string"
                                },
                                {
                                    "id": "breed",
                                    "comment": "Breed name",
                                    "kind": "string"
                                },
                                {
                                    "id": "priceUsd",
                                    "comment": "Price in USD",
                                    "kind": "float"
                                },
                                {
                                    "id": "photoUrl",
                                    "comment": "URL of the dog's photo",
                                    "kind": "string"
                                }
                            ]
                        }
                    ]
                }
            ],
            "error": [
                {
                    "id": "InvalidQuery",
                    "comment": "The search query is malformed or empty"
                }
            ],
            "trait": [
                {
                    "id": "http/method",
                    "comment": "HTTP method for this operation",
                    "value": "GET"
                },
                {
                    "id": "http/path",
                    "comment": "URL path for this operation",
                    "value": "/dogs/search"
                },
                {
                    "id": "cli/command",
                    "comment": "CLI command name for this operation",
                    "value": "search-dogs"
                },
                {
                    "id": "otel/span",
                    "comment": "OpenTelemetry span name",
                    "value": "SearchDogs"
                }
            ]
        }
    ],
    "trait": []
}